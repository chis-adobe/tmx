{
  "groups": [
    {
      "title": "Default Content",
      "id": "default",
      "components": [
        {
          "title": "Text",
          "id": "text",
          "plugins": {
            "da": {
              "name": "text",
              "type": "text"
            }
          }
        },
        {
          "title": "Image",
          "id": "image",
          "model": "image",
          "plugins": {
            "da": {
              "name": "image",
              "type": "image",
              "fields": [
                {
                  "name": "image",
                  "selector": "img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "img[alt]"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Sections",
      "id": "sections",
      "components": [
        {
          "title": "Section",
          "id": "section",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>"
            }
          },
          "filter": "section",
          "model": "section"
        }
      ]
    },
    {
      "title": "Blocks",
      "id": "blocks",
      "components": [
        {
          "title": "Accordion",
          "id": "accordion",
          "model": "accordion",
          "filter": "accordion",
          "plugins": {
            "da": {
              "name": "accordion",
              "rows": 0,
              "columns": 0
            }
          }
        },
        {
          "title": "Accordion Item",
          "id": "accordion-item",
          "model": "accordion-item",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "summary",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Article",
          "id": "article",
          "model": "article",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"article\"><div><div><p>Title</p></div><div><p>Article title</p></div></div><div><div><p>Description</p></div><div></div></div><div><div><p>Date</p></div><div><p>Month D, YYYY</p></div></div><div><div><p>City</p></div><div></div></div><div><div><p>Tags</p></div><div></div></div><div><div><p>Image</p></div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div><p>Summary</p></div><div><p>Summary</p></div></div><div><div><p>Author</p></div><div></div></div><div><div><p>Contact</p></div><div></div></div><div><div><p>Related Document</p></div><div></div></div></div>",
              "fields": [
                {
                  "name": "title",
                  "selector": "div:nth-child(1)>div:nth-child(2)"
                },
                {
                  "name": "description",
                  "selector": "div:nth-child(2)>div:nth-child(2)"
                },
                {
                  "name": "date",
                  "selector": "div:nth-child(3)>div:nth-child(2)"
                },
                {
                  "name": "city",
                  "selector": "div:nth-child(4)>div:nth-child(2)"
                },
                {
                  "name": "tags",
                  "selector": "div:nth-child(5)>div:nth-child(2)"
                },
                {
                  "name": "image",
                  "selector": "div:nth-child(6)>div:nth-child(2)>picture>img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div:nth-child(6)>div:nth-child(2)>picture>img[alt]"
                },
                {
                  "name": "summary",
                  "selector": "div:nth-child(7)>div:nth-child(2)"
                },
                {
                  "name": "author",
                  "selector": "div:nth-child(8)>div:nth-child(2)>p>a[href]"
                },
                {
                  "name": "contact",
                  "selector": "div:nth-child(9)>div:nth-child(2)>p>a[href]"
                },
                {
                  "name": "relatedDocument",
                  "selector": "div:nth-child(10)>div:nth-child(2)>p>a[href]"
                },
                {
                  "name": "relatedDocumentText",
                  "selector": "div:nth-child(10)>div:nth-child(2)>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Author",
          "id": "author",
          "model": "author",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"author\"><div><div><p>Photo</p></div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div><p>Name</p></div><div><p>Name</p></div></div><div><div><p>Role</p></div><div><p>Role</p></div></div><div><div><p>Phone</p></div><div></div></div><div><div><p>Email</p></div><div></div></div><div><div><p>Link</p></div><div><p><a href=\"https://www.linkedin.com/\">Follow on LinkedIn</a></p></div></div></div>",
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1)>div:nth-child(2)>picture>img[src]"
                },
                {
                  "name": "name",
                  "selector": "div:nth-child(2)>div:nth-child(2)"
                },
                {
                  "name": "title",
                  "selector": "div:nth-child(3)>div:nth-child(2)"
                },
                {
                  "name": "phone",
                  "selector": "div:nth-child(4)>div:nth-child(2)"
                },
                {
                  "name": "email",
                  "selector": "div:nth-child(5)>div:nth-child(2)"
                },
                {
                  "name": "linkedin",
                  "selector": "div:nth-child(6)>div:nth-child(2)>p>a[href]"
                },
                {
                  "name": "linkedinText",
                  "selector": "div:nth-child(6)>div:nth-child(2)>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Card Carousel",
          "id": "card-carousel",
          "plugins": {
            "da": {
              "rows": 0,
              "columns": 0
            }
          },
          "model": "card-carousel",
          "filter": "card-carousel"
        },
        {
          "title": "Card",
          "id": "card",
          "model": "card",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1)>picture>img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div:nth-child(1)>picture>img[alt]"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Cards",
          "id": "cards",
          "plugins": {
            "da": {
              "rows": 0,
              "columns": 0
            }
          },
          "model": "cards",
          "filter": "cards"
        },
        {
          "title": "Carousel",
          "id": "carousel",
          "model": "carousel",
          "plugins": {
            "da": {
              "rows": 0,
              "columns": 0
            }
          }
        },
        {
          "title": "Carousel Slide",
          "id": "carousel-item",
          "model": "carousel-item",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "backgroundImage",
                  "selector": "div:nth-child(1)>picture>img[src]"
                },
                {
                  "name": "backgroundImageAlt",
                  "selector": "div:nth-child(1)>picture>img[alt]"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Columns",
          "id": "columns",
          "model": "columns",
          "filter": "columns",
          "plugins": {
            "da": {
              "name": "columns",
              "rows": 1,
              "columns": 2,
              "behaviour": "columns"
            }
          }
        },
        {
          "title": "Columns Row",
          "id": "columns-row",
          "model": "columns-row",
          "filter": "columns-row",
          "plugins": {
            "da": {
              "name": "columns-row",
              "behaviour": "columns-row"
            }
          }
        },
        {
          "title": "Columns Cell",
          "id": "columns-cell",
          "model": "columns-cell",
          "filter": "columns-cell",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>",
              "behaviour": "columns-cell"
            }
          }
        },
        {
          "title": "Fragment",
          "id": "fragment",
          "model": "fragment",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"fragment\"><div><div><p><a href=\"\">Fragment URL</a></p></div></div></div>",
              "fields": [
                {
                  "name": "url",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "urlText",
                  "selector": "div>div>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Hero",
          "id": "hero",
          "model": "hero",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"hero\"><div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture><h1></h1></div></div></div>",
              "fields": [
                {
                  "name": "image",
                  "selector": "div>div>picture>img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div>div>picture>img[alt]"
                },
                {
                  "name": "text",
                  "selector": "div>div>h1"
                }
              ]
            }
          }
        },
        {
          "title": "News and Insights",
          "id": "news-and-insights",
          "model": "news-and-insights",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"news-and-insights\"><div><div><p><a href=\"/povs/\">Article</a></p></div></div></div>",
              "fields": [
                {
                  "name": "articles",
                  "selector": "div:nth-child(1)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Quote",
          "id": "quote",
          "model": "quote",
          "plugins": {
            "da": {
              "rows": 2,
              "columns": 1,
              "fields": [
                {
                  "name": "quote",
                  "selector": "div:nth-child(1)>div"
                },
                {
                  "name": "author",
                  "selector": "div:nth-child(2)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Search",
          "id": "search",
          "model": "search",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "searchUrl",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "searchUrlText",
                  "selector": "div>div>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Section Title",
          "id": "section-title",
          "model": "section-title",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"section-title\"><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div></div>",
              "rows": 8,
              "columns": 1,
              "fields": [
                {
                  "name": "title",
                  "selector": "div:nth-child(1)>div"
                },
                {
                  "name": "titleType",
                  "selector": "div:nth-child(2)>div"
                },
                {
                  "name": "title-size",
                  "selector": "div:nth-child(3)>div"
                },
                {
                  "name": "alignment",
                  "selector": "div:nth-child(4)>div"
                },
                {
                  "name": "classes",
                  "selector": "div:nth-child(5)>div"
                },
                {
                  "name": "subtitle",
                  "selector": "div:nth-child(6)>div"
                },
                {
                  "name": "subtitleType",
                  "selector": "div:nth-child(7)>div"
                },
                {
                  "name": "subtitle-size",
                  "selector": "div:nth-child(8)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Table",
          "id": "table",
          "model": "table",
          "filter": "table",
          "plugins": {
            "da": {
              "name": "table",
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "table",
                  "selector": "div>div"
                }
              ]
            }
          }
        },
        {
          "title": "Tabs",
          "id": "tabs",
          "model": "tabs",
          "filter": "tabs",
          "plugins": {
            "da": {
              "columns": 0,
              "rows": 0
            }
          }
        },
        {
          "title": "Tabs Item",
          "id": "tabs-item",
          "model": "tabs-item",
          "plugins": {
            "da": {
              "columns": 2,
              "rows": 1,
              "fields": [
                {
                  "name": "name",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Video",
          "id": "video",
          "model": "video",
          "plugins": {
            "da": {
              "name": "video",
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "videoUrl",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "videoUrlText",
                  "selector": "div>div>p>a"
                },
                {
                  "name": "posterImage",
                  "selector": "div>div>picture>img[src]"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}