      {
        "component": "text",
        "valueType": "string",
        "name": "tags",
        "label": "Tags",
        "description": "Separate tags with spaces or commas, e.g. #TSX30 #Mining"
      },
      {
        "component": "reference",
        "valueType": "string",
        "name": "image",
        "label": "Teaser image",
        "description": "Used on cards that reference this article",
        "multi": false
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "imageAlt",
        "label": "Teaser image alt text"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "summary",
        "label": "Summary",
        "description": "One line, used on cards that reference this article"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "author",
        "label": "Author page",
        "description": "Link to the author page, e.g. /authors/dean-mcpherson. Their card is shown after the article text"
      }
    ]
  },
  {
    "id": "press-release-metadata",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
