  {
    "id": "pov-metadata",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
        "name": "title",
        "label": "Title",
        "description": "The article headline, shown at the top of the page",
        "required": true
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "date",
        "label": "Publish date",
        "description": "Shown as written, e.g. September 22, 2026"
