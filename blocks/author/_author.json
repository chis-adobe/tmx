{
  "definitions": [
    {
      "title": "Author",
      "id": "author",
      "model": "author",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"author\"><div><div><p>Photo</p></div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div><p>Name</p></div><div><p>Name</p></div></div><div><div><p>Role</p></div><div><p>Role</p></div></div><div><div><p>Phone</p></div><div></div></div><div><div><p>Email</p></div><div></div></div><div><div><p>Link</p></div><div><p><a href=\"https://www.linkedin.com/\">Follow on LinkedIn</a></p></div></div></div>",
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1)>div:nth-child(2)>picture>img[src]"
            },
            {
              "name": "person_name",
              "selector": "div:nth-child(2)>div:nth-child(2)"
            },
            {
              "name": "person_title",
              "selector": "div:nth-child(3)>div:nth-child(2)"
            },
            {
              "name": "contact_phone",
              "selector": "div:nth-child(4)>div:nth-child(2)"
            },
            {
              "name": "contact_email",
              "selector": "div:nth-child(5)>div:nth-child(2)"
            },
            {
              "name": "linkedin",
              "selector": "div:nth-child(6)>div:nth-child(2)>p>a[href]"
            },
            {
              "name": "linkedinText",
              "selector": "div:nth-child(6)>div:nth-child(2)>p>a"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "author",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Photo",
          "description": "Profile photo. The author's name is used as its alt text.",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "person_name",
          "label": "Name",
          "required": true
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "person_title",
          "label": "Role"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "contact_phone",
          "label": "Phone",
          "description": "Optional, e.g. 416-671-1704"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "contact_email",
          "label": "Email",
          "description": "Optional, e.g. name@tmx.com"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkedin",
          "label": "LinkedIn profile URL",
          "description": "The photo and the name link here too."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkedinText",
          "label": "LinkedIn link text",
          "description": "e.g. Follow Dean on LinkedIn"
        }
      ]
    }
  ],
  "filters": []
}
