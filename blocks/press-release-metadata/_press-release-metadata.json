{
  "definitions": [
    {
      "title": "Press Release Metadata",
      "id": "press-release-metadata",
      "model": "press-release-metadata",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"press-release-metadata\"><div><div><p>Title</p></div><div><p>Press release headline</p></div></div><div><div><p>Description</p></div><div></div></div><div><div><p>Date</p></div><div><p>Month D, YYYY</p></div></div><div><div><p>City</p></div><div><p>Toronto</p></div></div><div><div><p>Tags</p></div><div></div></div><div><div><p>Contact</p></div><div></div></div><div><div><p>Related Document</p></div><div></div></div></div>",
          "fields": [
            {
              "name": "title",
              "selector": "div:nth-child(1)>div:nth-child(2)"
            },
            {
              "name": "description",
              "selector": "div:nth-child(2)>div:nth-child(2)"
            },
            {
              "name": "date",
              "selector": "div:nth-child(3)>div:nth-child(2)"
            },
            {
              "name": "city",
              "selector": "div:nth-child(4)>div:nth-child(2)"
            },
            {
              "name": "tags",
              "selector": "div:nth-child(5)>div:nth-child(2)"
            },
            {
              "name": "contact",
              "selector": "div:nth-child(6)>div:nth-child(2)>p>a[href]"
            },
            {
              "name": "relatedDocument",
              "selector": "div:nth-child(7)>div:nth-child(2)>p>a[href]"
            },
            {
              "name": "relatedDocumentText",
              "selector": "div:nth-child(7)>div:nth-child(2)>p>a"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "press-release-metadata",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title",
          "description": "The release headline, shown at the top of the page",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "description",
          "label": "Description",
          "description": "Optional bold line under the title, e.g. the marketplaces it covers"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "date",
          "label": "Publish date",
          "description": "Shown as written, e.g. November 10, 2026"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "city",
          "label": "City",
          "description": "Dateline city, e.g. Toronto. Shown as \"Date (CITY) –\" at the start of the text"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tags",
          "label": "Tags",
          "description": "Optional, separate with spaces or commas"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "contact",
          "label": "Contact page",
          "description": "Link to the media contact's author page, e.g. /authors/catherine-kee. Shown at the bottom of the page"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "relatedDocument",
          "label": "Related document URL",
          "description": "Link to the PDF, shown right after the release text"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "relatedDocumentText",
          "label": "Related document link text"
        }
      ]
    }
  ],
  "filters": []
}
